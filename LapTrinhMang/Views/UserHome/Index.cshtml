@{
    ViewData["Title"] = "Đặt bàn";
    var userName = (ViewBag.Name ?? "").ToString();
    var userPhone = (ViewBag.Phone ?? "").ToString();
}

<link rel="stylesheet" href="~/css/user-booking.css" />

<div class="wrap">
    <div class="topbar">
        <div>
            <h2 class="title">Đặt bàn</h2>
            <div class="subtitle">Chọn ngày → hệ thống tự tính “suất trống” từng bàn. Popup chỉ nhập SĐT + chọn suất.</div>
        </div>

        <div class="controls">
            <div class="ctrl">
                <span>Ngày</span>
                <input id="pageDate" type="date" />
            </div>

            <div class="ctrl">
                <span>Lọc</span>
                <select id="filter">
                    <option value="">Tất cả</option>
                    <option value="Available">Còn suất</option>
                    <option value="Full">Hết suất</option>
                </select>
            </div>

            <button class="btn" type="button" id="btnLogout">Logout</button>
        </div>
    </div>

    <div id="grid" class="grid"></div>

    <pre id="rtlog" style="display:none"></pre>
</div>

<!-- ===== POPUP: CHỈ SĐT + SUẤT ===== -->
<dialog id="bookDlg">
    <div class="dlgTop">
        <div>
            <div class="dlgTitle">Đặt bàn <span id="dlgTableNo"></span></div>
            <div class="dlgSub">Ngày đang chọn: <b id="dlgDateLabel"></b> — chọn suất còn trống để gửi yêu cầu.</div>
        </div>
        <button type="button" class="xbtn" id="dlgCloseX">×</button>
    </div>

    <div class="dlgBody">
        <div class="field" style="margin-bottom:10px;">
            <label>Tên khách</label>
            <input id="dlgName" placeholder="Nhập tên..." />
        </div>

        <div class="field" style="margin-bottom:10px;">
            <label>SĐT</label>
            <input id="dlgPhone" placeholder="Nhập số điện thoại..." />
        </div>

        <div class="field">
            <label>Chọn suất giờ</label>
            <select id="dlgSlot">
                <option value="">-- Chọn suất giờ --</option>
            </select>
            <div class="help">Suất đã có người đặt sẽ không hiện.</div>
        </div>

        <div id="dlgErr" class="msgErr"></div>
        <div id="dlgOk" class="msgOk"></div>
    </div>

    <div class="dlgFoot">
        <button type="button" class="btnGhost" id="dlgCancel">Hủy</button>
        <button type="button" class="btnPrimary" id="dlgSubmitBtn">Xác nhận đặt bàn</button>
    </div>
</dialog>

<script>
    // ✅ Đẩy dữ liệu Razor ra ngoài cho file JS dùng
    window.BOOKING_CFG = {
        baseUrl: location.origin,
        loggedName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userName)),
        loggedPhone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPhone))
    };
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/user-booking.js"></script>
