@{
    ViewData["Title"] = "Liên hệ - FOURMEN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="contact-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="container">
            <span class="hero-label animate-fade-in">Liên hệ</span>
            <h1 class="hero-title animate-fade-in-delay">Kết nối với FOURMEN</h1>
            <div class="hero-divider animate-fade-in-delay-2"></div>
            <p class="hero-description animate-fade-in-delay-3">
                Chúng tôi luôn sẵn sàng lắng nghe và phục vụ bạn
            </p>
        </div>
    </div>
</section>

<!-- Contact Info Section -->
<section class="contact-info-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="info-card reveal-fade delay-1">
                    <div class="info-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h3 class="info-title">Địa chỉ</h3>
                    <p class="info-text">
                        123 Đường Lê Lợi<br>
                        Quận 1, TP. Hồ Chí Minh
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="info-card reveal-fade delay-2">
                    <div class="info-icon">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <h3 class="info-title">Điện thoại</h3>
                    <p class="info-text">
                        <a href="tel:+84123456789">0123 456 789</a><br>
                        <a href="tel:+84987654321">0987 654 321</a>
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="info-card reveal-fade delay-3">
                    <div class="info-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <h3 class="info-title">Email</h3>
                    <p class="info-text">
                        <a href="mailto:info@fourmen.vn">info@fourmen.vn</a><br>
                        <a href="mailto:booking@fourmen.vn">booking@fourmen.vn</a>
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="info-card reveal-fade delay-4">
                    <div class="info-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h3 class="info-title">Giờ mở cửa</h3>
                    <p class="info-text">
                        Thứ 2 - Thứ 6: 10:00 - 22:00<br>
                        Thứ 7 - CN: 09:00 - 23:00
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Contact Section -->
<section class="main-contact-section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <!-- Contact Form -->
            <div class="col-lg-7 order-lg-1">
                <div class="contact-form-wrapper reveal-fade delay-1">
                    <div class="form-header">
                        <span class="section-label">Gửi tin nhắn</span>
                        <h2 class="section-title">Liên hệ với chúng tôi</h2>
                        <div class="title-decoration"></div>
                        <p class="form-description">
                            Để lại thông tin và chúng tôi sẽ liên hệ lại trong vòng 24 giờ
                        </p>
                    </div>

                    <form class="contact-form" id="contactForm">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Họ và tên</label>
                                    <input type="text" class="form-input" required>
                                    <span class="form-line"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="tel" class="form-input" required>
                                    <span class="form-line"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-input" required>
                                    <span class="form-line"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Loại yêu cầu</label>
                                    <select class="form-input" required>
                                        <option value="">Chọn loại yêu cầu</option>
                                        <option value="booking">Đặt bàn</option>
                                        <option value="event">Tổ chức sự kiện</option>
                                        <option value="menu">Thắc mắc về menu</option>
                                        <option value="feedback">Góp ý - Phản hồi</option>
                                        <option value="other">Khác</option>
                                    </select>
                                    <span class="form-line"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Nội dung tin nhắn</label>
                                    <textarea class="form-input" rows="6" required></textarea>
                                    <span class="form-line"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn-submit">
                                    <span>Gửi tin nhắn</span>
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Additional Info Card -->
            <div class="col-lg-5 order-lg-2">
                <div class="additional-info reveal-fade delay-2">
                    <div class="info-box">
                        <div class="info-box-header">
                            <div class="info-box-icon">
                                <i class="fas fa-concierge-bell"></i>
                            </div>
                            <h3 class="info-box-title">Dịch vụ đặt bàn</h3>
                        </div>
                        <p class="info-box-text">
                            Đặt bàn trước để đảm bảo chỗ ngồi tốt nhất. Chúng tôi chấp nhận đặt bàn
                            từ 2-30 ngày trước.
                        </p>
                        <a asp-controller="UserHome" asp-action="Index" class="info-link">
                            Đặt bàn ngay
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>

                    <div class="info-box">
                        <div class="info-box-header">
                            <div class="info-box-icon">
                                <i class="fas fa-gifts"></i>
                            </div>
                            <h3 class="info-box-title">Tổ chức sự kiện</h3>
                        </div>
                        <p class="info-box-text">
                            Phòng VIP riêng biệt, menu đặc biệt và dịch vụ tổ chức sự kiện
                            chuyên nghiệp cho mọi dịp.
                        </p>
                        <a href="#" class="info-link">
                            Tìm hiểu thêm
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>

                    <div class="info-box">
                        <div class="info-box-header">
                            <div class="info-box-icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <h3 class="info-box-title">Chương trình thành viên</h3>
                        </div>
                        <p class="info-box-text">
                            Tham gia chương trình khách hàng thân thiết để nhận nhiều ưu đãi
                            và quà tặng đặc biệt.
                        </p>
                        <a href="#" class="info-link">
                            Đăng ký ngay
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>

                    <div class="social-connect">
                        <h4 class="social-title">Kết nối với chúng tôi</h4>
                        <div class="social-links">
                            <a href="#" class="social-link">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" class="social-link">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" class="social-link">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="social-link">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Section -->
<section class="map-section">
    <div class="container">
        <div class="map-wrapper reveal-fade">
            <div class="map-header">
                <span class="section-label">Vị trí</span>
                <h2 class="section-title">Tìm đường đến FOURMEN</h2>
                <div class="title-decoration mx-auto"></div>
            </div>
            <div class="map-container">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.447946568876!2d106.697329!3d10.777992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f38d7d79f6d%3A0x8f2c1e1e8e8b8e8b!2sRestaurant!5e0!3m2!1svi!2s!4v1700000000000"
                        width="100%"
                        height="500"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
                <div class="map-overlay">
                    <div class="map-info">
                        <h3>FOURMEN Restaurant</h3>
                        <p>123 Đường Lê Lợi, Quận 1, TP.HCM</p>
                        <a href="https://maps.google.com" target="_blank" class="map-button">
                            <i class="fas fa-directions"></i>
                            Chỉ đường
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary-color: #1a1a1a;
        --secondary-color: #c9a961;
        --accent-color: #8b7355;
        --text-dark: #2c2c2c;
        --text-light: #6c6c6c;
        --bg-light: #f8f6f3;
        --white: #ffffff;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Cormorant Garamond', 'Times New Roman', serif;
        color: var(--text-dark);
        line-height: 1.6;
        overflow-x: hidden;
    }

    /* Hero Section */
    .contact-hero {
        position: relative;
        height: 70vh;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.3) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .hero-label {
        font-size: 0.9rem;
        letter-spacing: 3px;
        color: var(--secondary-color);
        text-transform: uppercase;
        font-weight: 600;
        display: block;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 400;
        letter-spacing: 8px;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-family: 'Cinzel', serif;
    }

    .hero-divider {
        width: 100px;
        height: 1px;
        background: var(--secondary-color);
        margin: 0 auto 25px;
    }

    .hero-description {
        font-size: 1.3rem;
        max-width: 700px;
        margin: 0 auto;
        color: rgba(255,255,255,0.9);
        font-weight: 300;
    }

    /* Contact Info Section */
    .contact-info-section {
        padding: 80px 0;
        background: var(--white);
        margin-top: -80px;
        position: relative;
        z-index: 10;
    }

    .info-card {
        background: var(--white);
        padding: 50px 30px;
        text-align: center;
        border: 1px solid #e8e5e0;
        transition: all 0.4s ease;
        height: 100%;
    }

        .info-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            border-color: var(--secondary-color);
        }

    .info-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--secondary-color);
        border-radius: 50%;
        color: var(--secondary-color);
        font-size: 2rem;
        transition: all 0.4s ease;
    }

    .info-card:hover .info-icon {
        background: var(--secondary-color);
        color: var(--white);
        transform: rotateY(360deg);
    }

    .info-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-text {
        font-size: 1.1rem;
        color: var(--text-light);
        line-height: 1.8;
        margin: 0;
    }

        .info-text a {
            color: var(--text-light);
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .info-text a:hover {
                color: var(--secondary-color);
            }

    /* Main Contact Section */
    .main-contact-section {
        padding: 120px 0;
        background: var(--bg-light);
    }

    .contact-form-wrapper {
        background: var(--white);
        padding: 60px 50px;
        border: 1px solid #e8e5e0;
    }

    .form-header {
        margin-bottom: 50px;
    }

    .section-label {
        font-size: 0.9rem;
        letter-spacing: 3px;
        color: var(--secondary-color);
        text-transform: uppercase;
        font-weight: 600;
        display: block;
        margin-bottom: 15px;
    }

    .section-title {
        font-size: 3rem;
        font-weight: 400;
        color: var(--primary-color);
        margin-bottom: 20px;
        line-height: 1.2;
    }

    .title-decoration {
        width: 60px;
        height: 2px;
        background: var(--secondary-color);
        margin-bottom: 30px;
    }

    .form-description {
        font-size: 1.1rem;
        color: var(--text-light);
        line-height: 1.7;
    }

    /* Form Styles */
    .form-group {
        position: relative;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .form-input {
        width: 100%;
        padding: 15px 0;
        font-size: 1.1rem;
        color: var(--text-dark);
        background: transparent;
        border: none;
        border-bottom: 2px solid #e8e5e0;
        outline: none;
        transition: all 0.3s ease;
        font-family: 'Cormorant Garamond', serif;
    }

        .form-input:focus {
            border-bottom-color: var(--secondary-color);
        }

            .form-input:focus ~ .form-line {
                width: 100%;
            }

    .form-line {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--secondary-color);
        transition: width 0.4s ease;
    }

    textarea.form-input {
        resize: vertical;
        min-height: 120px;
    }

    select.form-input {
        cursor: pointer;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        padding: 18px 50px;
        background: var(--secondary-color);
        color: var(--white);
        border: 2px solid var(--secondary-color);
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: var(--primary-color);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
            z-index: 0;
        }

        .btn-submit:hover::before {
            width: 400px;
            height: 400px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(201, 169, 97, 0.4);
        }

        .btn-submit span,
        .btn-submit i {
            position: relative;
            z-index: 1;
        }

    /* Additional Info */
    .additional-info {
        position: sticky;
        top: 100px;
    }

    .info-box {
        background: var(--white);
        padding: 40px 35px;
        border: 1px solid #e8e5e0;
        margin-bottom: 30px;
        transition: all 0.4s ease;
    }

        .info-box:hover {
            transform: translateX(10px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
            border-color: var(--secondary-color);
        }

    .info-box-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-box-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-light);
        color: var(--secondary-color);
        font-size: 1.5rem;
        flex-shrink: 0;
        transition: all 0.4s ease;
    }

    .info-box:hover .info-box-icon {
        background: var(--secondary-color);
        color: var(--white);
        transform: scale(1.1);
    }

    .info-box-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--primary-color);
        margin: 0;
    }

    .info-box-text {
        font-size: 1rem;
        color: var(--text-light);
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .info-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--secondary-color);
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .info-link:hover {
            gap: 15px;
            color: var(--primary-color);
        }

        .info-link i {
            transition: transform 0.3s ease;
        }

        .info-link:hover i {
            transform: translateX(5px);
        }

    /* Social Connect */
    .social-connect {
        background: var(--primary-color);
        padding: 40px 35px;
        text-align: center;
    }

    .social-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .social-links {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .social-link {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--secondary-color);
        color: var(--secondary-color);
        font-size: 1.2rem;
        text-decoration: none;
        transition: all 0.4s ease;
    }

        .social-link:hover {
            background: var(--secondary-color);
            color: var(--primary-color);
            transform: translateY(-5px) rotate(360deg);
        }

    /* Map Section */
    .map-section {
        padding: 120px 0;
        background: var(--white);
    }

    .map-wrapper {
        text-align: center;
    }

    .map-header {
        margin-bottom: 60px;
    }

    .map-container {
        position: relative;
        border-radius: 2px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

        .map-container iframe {
            display: block;
            width: 100%;
            filter: grayscale(20%);
            transition: filter 0.4s ease;
        }

        .map-container:hover iframe {
            filter: grayscale(0%);
        }

    .map-overlay {
        position: absolute;
        bottom: 40px;
        left: 40px;
        background: var(--white);
        padding: 30px 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        max-width: 400px;
    }

    .map-info h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 10px;
    }

    .map-info p {
        font-size: 1rem;
        color: var(--text-light);
        margin-bottom: 20px;
    }

    .map-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 30px;
        background: var(--secondary-color);
        color: var(--white);
        text-decoration: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .map-button:hover {
            background: var(--primary-color);
            transform: translateY(-2px);
        }

    /* Animations */
    .animate-fade-in {
        animation: fadeIn 1.2s ease-out;
    }

    .animate-fade-in-delay {
        animation: fadeIn 1.2s ease-out 0.3s both;
    }

    .animate-fade-in-delay-2 {
        animation: fadeIn 1.2s ease-out 0.6s both;
    }

    .animate-fade-in-delay-3 {
        animation: fadeIn 1.2s ease-out 0.9s both;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Scroll Reveal */
    .reveal-fade {
        opacity: 0;
        transform: translateY(50px);
        transition: all 1s ease-out;
    }

        .reveal-fade.active {
            opacity: 1;
            transform: translateY(0);
        }

    .delay-1 {
        transition-delay: 0.1s;
    }

    .delay-2 {
        transition-delay: 0.2s;
    }

    .delay-3 {
        transition-delay: 0.3s;
    }

    .delay-4 {
        transition-delay: 0.4s;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .hero-title {
            font-size: 3rem;
            letter-spacing: 5px;
        }

        .section-title {
            font-size: 2.5rem;
        }

        .contact-form-wrapper {
            padding: 40px 30px;
        }

        .additional-info {
            position: static;
            margin-top: 50px;
        }

        .map-overlay {
            position: static;
            margin-top: 20px;
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
