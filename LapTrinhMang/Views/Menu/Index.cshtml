<style>
    :root {
        --primary-color: #1a1a1a;
        --secondary-color: #c9a961;
        --accent-color: #8b7355;
        --text-dark: #2c2c2c;
        --text-light: #6c6c6c;
        --bg-light: #f8f6f3;
        --white: #ffffff;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Cormorant Garamond', 'Times New Roman', serif;
        color: var(--text-dark);
        line-height: 1.6;
        overflow-x: hidden;
    }

    /* Hero Section */
    .menu-hero {
        position: relative;
        height: 70vh;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.3) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .hero-label {
        font-size: 0.9rem;
        letter-spacing: 3px;
        color: var(--secondary-color);
        text-transform: uppercase;
        font-weight: 600;
        display: block;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 400;
        letter-spacing: 8px;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-family: 'Cinzel', serif;
    }

    .hero-divider {
        width: 100px;
        height: 1px;
        background: var(--secondary-color);
        margin: 0 auto 25px;
    }

    .hero-description {
        font-size: 1.3rem;
        max-width: 700px;
        margin: 0 auto;
        color: rgba(255,255,255,0.9);
        font-weight: 300;
    }

    /* Menu Navigation */
    .menu-navigation {
        background: var(--white);
        padding: 60px 0;
        border-bottom: 1px solid #e8e5e0;
    }

    .menu-tabs {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .menu-tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 30px 40px;
        background: transparent;
        border: 2px solid #e8e5e0;
        cursor: pointer;
        transition: all 0.4s ease;
        color: var(--text-dark);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        min-width: 180px;
    }

        .menu-tab:hover {
            border-color: var(--secondary-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .menu-tab.active {
            background: var(--secondary-color);
            border-color: var(--secondary-color);
            color: var(--white);
        }

    .tab-icon {
        font-size: 2rem;
        transition: transform 0.4s ease;
    }

    .menu-tab:hover .tab-icon,
    .menu-tab.active .tab-icon {
        transform: scale(1.2);
    }

    .tab-text {
        font-weight: 600;
    }

    /* Menu Section */
    .menu-section {
        padding: 120px 0;
        background: var(--bg-light);
    }

    .menu-category {
        display: none;
    }

        .menu-category.active {
            display: block;
        }

    .category-header {
        margin-bottom: 80px;
    }

    .section-label {
