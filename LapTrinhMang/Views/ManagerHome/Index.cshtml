@{
    ViewData["Title"] = "Quản lý bàn";
}

<link rel="stylesheet" href="~/css/manager-tables.css" asp-append-version="true" />

<div class="wrap">
    <div class="topbar">
        <div>
            <h2 class="title">Quản lý bàn (20 bàn)</h2>
            <div class="subtitle">
                Chọn ngày để xem “suất trống / hết suất” giống bên User. Bàn có Pending sẽ hiện Pending (n) để vào duyệt.
            </div>
        </div>

        <div class="controls">
            <div class="ctrl">
                <span>Ngày</span>
                <input id="pageDate" type="date" />
            </div>

            <div class="ctrl">
                <span>Lọc</span>
                <select id="filter">
                    <option value="">Tất cả</option>
                    <option value="Available">Available</option>
                    <option value="Pending">Pending</option>
                    <option value="Reserved">Reserved</option>
                    <option value="Full">Full</option>
                </select>
            </div>

            <a class="btnGhost" href="/ManagerHome/Reservations">Danh sách đặt bàn</a>
            <button class="btn" type="button" id="btnLogout">Logout</button>
        </div>
    </div>

    <div id="grid" class="grid"></div>

    <pre id="rtlog" style="display:none"></pre>
</div>

<!-- ===== DIALOG: ĐƠN ĐẶT BÀN THEO BÀN ===== -->
<dialog id="resDlg">
    <div class="dlgTop">
        <div>
            <div class="dlgTitle" id="resTitle">Đơn đặt bàn</div>
            <div class="dlgSub" id="resHint"></div>
        </div>
        <button type="button" class="xbtn" id="resCloseX">×</button>
    </div>

    <div class="dlgBody">
        <div class="resBar">
            <div class="ctrl">
                <span>Trạng thái</span>
                <select id="resFilter">
                    <option value="">Tất cả</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Canceled">Canceled</option>
                </select>
            </div>

            <button class="btnSmall" type="button" id="btnResReload">Refresh</button>
        </div>

        <div id="resList"></div>
    </div>

    <div class="dlgFoot">
        <button type="button" class="btnGhost" id="btnResClose">Đóng</button>
    </div>
</dialog>

<script>
    window.MANAGER_CFG = { baseUrl: location.origin };
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/manager-tables.js" asp-append-version="true"></script>
