@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .card-header {
            background: #2563eb;
            color: white;
            text-align: center;
            padding: 2rem;
        }

        .btn-primary {
            background: #2563eb;
            border: none;
            padding: 0.75rem;
            font-weight: 600;
        }

            .btn-primary:hover {
                background: #1d4ed8;
            }

        .form-control {
            border-radius: 12px;
            padding: 0.75rem 1rem;
        }

            .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.25);
            }

        .back-link {
            text-align: center;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Đăng ký tài khoản</h3>
                    </div>
                    <div class="card-body p-4">
                        <form id="registerForm">
                            <div class="mb-3">
                                <label for="phone" class="form-label">Số điện thoại</label>
                                <input type="tel" class="form-control" id="phone" placeholder="Nhập SĐT" required />
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Họ và tên</label>
                                <input type="text" class="form-control" id="name" placeholder="Nhập họ tên" required />
                            </div>
                            <div class="mb-4">
                                <label for="pass" class="form-label">Mật khẩu</label>
                                <input type="password" class="form-control" id="pass" placeholder="Nhập mật khẩu" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
                        </form>
                        <div id="message" class="mt-3 text-center"></div>
                        <div class="back-link">
                            <a href="/AuthView/Login" class="text-decoration-none">Đăng nhập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        const baseUrl = location.origin;
        const messageEl = document.getElementById("message");
        document.getElementById("registerForm").addEventListener("submit", async function(e) {
            e.preventDefault();
            messageEl.innerHTML = ""; // Xóa thông báo cũ
            const body = {
                phone: document.getElementById("phone").value.trim(),
                fullName: document.getElementById("name").value.trim(),
                password: document.getElementById("pass").value
            };
            try {
                const res = await fetch(baseUrl + "/api/auth/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(body)
                });
                const text = await res.text();
                if (res.ok) {
                    messageEl.innerHTML = '<div class="alert alert-success">Đăng ký thành công! Đang chuyển hướng đến trang Đăng nhập...</div>';
                    // Tự động redirect sau 2 giây
                    setTimeout(() => {
                        location.href = "/AuthView/Login";
                    }, 500);
                } else {
                    messageEl.innerHTML = `<div class="alert alert-danger">${res.status} ${text}</div>`;
                }
            } catch (err) {
                messageEl.innerHTML = '<div class="alert alert-danger">Lỗi kết nối. Vui lòng thử lại.</div>';
            }
        });
    </script>
</body>
</html>