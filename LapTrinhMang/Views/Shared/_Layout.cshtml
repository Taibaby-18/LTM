<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #0f172a;
            --accent: #b5924a;
            --text-main: #334155;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        h1, h2, h3, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 1rem 0;
        }

        .navbar-brand {
            font-size: 1.8rem;
            color: var(--primary) !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: var(--primary) !important;
            margin: 0 0.5rem;
            position: relative;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background: var(--accent);
                transition: all 0.3s;
                transform: translateX(-50%);
            }

            .nav-link:hover::after {
                width: 80%;
            }

        .btn-reserve {
            background: var(--primary);
            color: white !important;
            border-radius: 0;
            padding: 0.8rem 2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s;
            border: 1px solid var(--primary);
            text-decoration: none;
        }

            .btn-reserve:hover {
                background: transparent;
                color: var(--primary) !important;
            }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent);
            margin-right: 8px;
            vertical-align: middle;
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border-radius: 12px;
            overflow: hidden;
            margin-top: 10px !important;
        }

        .dropdown-item {
            padding: 10px 20px;
            font-weight: 500;
        }

            .dropdown-item:hover {
                background-color: var(--bg-light);
                color: var(--accent);
            }

        main {
            flex: 1;
            margin-top: 100px;
        }

        footer {
            background: var(--primary);
            color: #94a3b8;
            padding: 5rem 0 2rem;
            margin-top: auto;
        }

            footer h5 {
                color: white;
                margin-bottom: 1.5rem;
            }

        .footer-social a {
            color: white;
            font-size: 1.2rem;
            margin-right: 1.5rem;
            transition: color 0.3s;
        }

            .footer-social a:hover {
                color: var(--accent);
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    ABC <span style="color: var(--accent)">RESTAURANT</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Menu" asp-action="Index">Thực đơn</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="About" asp-action="Index">Câu chuyện</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-reserve me-3" asp-controller="UserHome" asp-action="Index">Đặt bàn</a>
                        }
                        else
                        {
                            <a class="btn btn-reserve me-3" asp-controller="AuthView" asp-action="Login">Đặt bàn</a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" data-bs-toggle="dropdown">
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=b5924a&color=fff" alt="Avatar" class="user-avatar" />
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="UserHome" asp-action="Profile"><i class="fas fa-user me-2"></i> Hồ sơ</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserHome" asp-action="BookingHistory"><i class="fas fa-history me-2"></i> Lịch sử</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="AuthView" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="AuthView" asp-action="Login">Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5>ABC RESTAURANT</h5>
                    <p>Nơi tinh hoa ẩm thực hội tụ trong không gian kiến trúc đương đại.</p>
                    <div class="footer-social">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <h5>LIÊN HỆ</h5>
                    <p><i class="fas fa-map-marker-alt me-2"></i> 123 Đường ABC, Quận 1, TP.HCM</p>
                    <p><i class="fas fa-phone me-2"></i> 0123 456 789</p>
                    <p><i class="fas fa-envelope me-2"></i> hello@abcrestaurant.com</p>
                </div>
                <div class="col-lg-4">
                    <h5>GIỜ MỞ CỬA</h5>
                    <p>Thứ 2 - Thứ 6: 09:00 - 22:00</p>
                    <p>Thứ 7 - CN: 08:00 - 23:00</p>
                </div>
            </div>
            <hr class="mt-5 border-secondary">
            <div class="text-center">
                <small>&copy; @DateTime.Now.Year ABC Restaurant. Crafted with passion.</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>